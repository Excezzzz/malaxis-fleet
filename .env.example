# Malaxis Fleet Manager - Environment Configuration

# --- Telegram Bot ---
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
ADMIN_CHAT_ID="YOUR_ADMIN_CHAT_ID_HERE"

# --- Initial Admin User ---
ADMIN_USER="owner"
ADMIN_PASS="changeme"

# --- Security ---
SECRET_TOKEN="YOUR_FLEET_SECRET_HERE"
SESSION_SECRET="YOUR_RANDOM_SESSION_SECRET"
# Login rate limit (requests per minute) applied to /api/auth/login per IP.
LOGIN_RATE_LIMIT="30"

# --- PostgreSQL (shared with docker-compose.yml) ---
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"
POSTGRES_USER="fleet_internal"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="fleet_db"

# --- Server ---
SERVER_PORT="8000"

# --- Subdomain Architecture ---
# Replace with the DNS names (A records) you point at your Caddy server.
# The web dashboard, agent API, join script download and client-file/OSS sub
# endpoints are routed by Host header and substituted into the deploy templates.
DASHBOARD_DOMAIN="dash.yourdomain.com"
API_DOMAIN="api.yourdomain.com"
JOIN_DOMAIN="join.yourdomain.com"
SUB_DOMAIN="sub.yourdomain.com"
DASHBOARD_URL="https://dash.yourdomain.com"
API_URL="https://api.yourdomain.com"
JOIN_URL="https://join.yourdomain.com"
SUB_URL="https://sub.yourdomain.com"

# --- CERTS ---
SSL_CERT_PATH="/cf-certs/cf.crt"
SSL_KEY_PATH="/cf-certs/cf.key"