# Malaxis Fleet Manager - Environment Configuration

# --- Telegram Bot ---
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
ADMIN_CHAT_ID="YOUR_ADMIN_CHAT_ID_HERE"

# --- Initial Admin User ---
ADMIN_USER="admin"
ADMIN_PASS="YOUR_STRONG_PASSWORD"

# --- Security ---
SECRET_TOKEN="YOUR_FLEET_SECRET_HERE"
SESSION_SECRET="YOUR_RANDOM_SESSION_SECRET"

# --- Subdomain Architecture ---
DASHBOARD_DOMAIN="dash-fleet.malaxis.ru"
API_DOMAIN="api-fleet.malaxis.ru"
JOIN_DOMAIN="join-fleet.malaxis.ru"
SUB_DOMAIN="sub-fleet.malaxis.ru"
DASHBOARD_URL="https://dash-fleet.malaxis.ru"
API_URL="https://api-fleet.malaxis.ru"
JOIN_URL="https://join-fleet.malaxis.ru"
SUB_URL="https://sub-fleet.malaxis.ru"

# --- CERTS ---
SSL_CERT_PATH="/cf-certs/cf.crt"
SSL_KEY_PATH="/cf-certs/cf.key"