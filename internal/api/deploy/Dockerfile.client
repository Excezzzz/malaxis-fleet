FROM python:3.11-alpine
# docker-cli + the compose v2 plugin let the agent run `docker compose` inside
# the container (docker-compose v1 standalone was dropped from Alpine repos).
RUN apk add --no-cache docker-cli docker-cli-compose
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY entrypoint.sh .
COPY node_agent.py .
COPY agent_src/ agent_src/
RUN chmod +x entrypoint.sh
CMD ["sh", "entrypoint.sh"]
