# === Environment & Secrets ===
# NEVER commit real credentials. Copy .env.example to .env and fill in your own values.
.env
.env.*
!.env.example

# === Agent runtime state (created locally on nodes, never committed) ===
configs/
configs/agent_state.json
configs/node_id.txt
configs/subscription_cache.json
configs/benchmark_cache.json
configs/xray_config.json
configs/singbox_config.json

# === Certificates & keys ===
*.crt
*.key
*.pem
certs/
certificates/

